# Local n8n runtime state — never commit
.n8n/
.n8n-local/

# Local n8n live import/export staging (bound live exports may carry credential
# IDs, spreadsheet IDs, and cached resource locator values) — never commit
.tmp/

# Private local AC2 member extracts and form response exports must never be committed
ac2_member_browse_extract*.csv
ac2_member_browse_extract_summary*.json
ac2_member_extract*.csv
PRIVATE_DO_NOT_COMMIT_MEMBER_BROWSE_EXTRACT.txt
*form_responses*.csv
*Form Responses*.csv

# Single-member creation UAT private local artifacts — never commit.
# Approval ledgers, immutable packages, sanitized terminal results, and VM-owned
# lock/write-intent/consumed markers bind to real member identity or VM runtime state.
# Patterns are narrow so the committed contract/config/schema files still commit.
member_create_uat_ledger*.jsonl
member_create_uat_package*.json
member_create_uat_result*.json
# Durable publication reservations: the local write-ahead single-use markers that block an
# approval after a publication or ledger persistence failure. Local operational state only.
member_create_uat_reservation_*.reservation
autocount_outputs/**/member_create_uat_reservation_*.reservation
# Transactional reviewer-decision AUTHORITY store (SQLite) plus its legitimate private
# runtime companions. Named exactly - never a broad *.sqlite3 pattern - so an unrelated
# committed database can never be hidden by these rules. It holds sanitised decision
# metadata only, but that metadata binds to real member identity through one-way hashes,
# so it is local-only operational state.
member_create_uat_decisions.sqlite3
member_create_uat_decisions.sqlite3-journal
member_create_uat_decisions.sqlite3-wal
member_create_uat_decisions.sqlite3-shm
# The operation-owned temporary a fully-formed store is built in before it is atomically
# published with a no-replace link, so no concurrent process can ever observe a partial store.
.mcuat_decisions_*.tmp
autocount_outputs/**/.mcuat_decisions_*.tmp
autocount_outputs/**/member_create_uat_decisions.sqlite3
autocount_outputs/**/member_create_uat_decisions.sqlite3-journal
autocount_outputs/**/member_create_uat_decisions.sqlite3-wal
autocount_outputs/**/member_create_uat_decisions.sqlite3-shm
autocount_outputs/**/member_create_uat_*.json
autocount_outputs/**/member_create_uat_*.jsonl
create_uat.lock
consumed_*.marker
write_intent_*.marker
PRIVATE_DO_NOT_COMMIT_MEMBER_CREATE_UAT.txt
# Synthetic ExpiryDate capability probe private evidence (claim, staging, result). The probe
# writes these only into its fixed canonical state root, which is outside any checkout; these
# patterns are defence-in-depth so a stray artifact can never be committed.
expiry_probe_claim_*.claim
expiry_probe_result_*.json
# The no-clobber staging artifact a result is durably written into before its no-replace move
# to the authoritative basename. A failed publication deliberately leaves it in place.
expiry_probe_staging_*.incomplete
# Keep the committed contract/config/schema/workflow (these are not private artifacts).
!config/member_create_uat_business_confirmation.json
!config/member_create_uat_business_confirmation.example.json
!schemas/member_create_uat_package.schema.json
!n8n-workflows/member_create_uat_result_mapping.workflow.json
