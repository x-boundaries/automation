# Placeholder shape of the private gateway env file named in compose.example.yaml.
# Names match config/member_gateway.production.example.json (config v3, five
# principals). Real values are created privately at deployment, never
# committed, never logged, and each bearer is pairwise distinct. The
# reference-HMAC key must never equal any bearer.
XB_MEMBER_GATEWAY_DATABASE_URL=REPLACE_WITH_PRIVATE_LEAST_PRIVILEGE_DSN
XB_MEMBER_GATEWAY_BIND_ADDRESS=REPLACE_WITH_PRIVATE_BACKEND_ADDRESS
XB_MEMBER_GATEWAY_BIND_PORT=REPLACE_WITH_PRIVATE_BACKEND_PORT
XB_MEMBER_GATEWAY_REFERENCE_HMAC_KEY=REPLACE_WITH_PRIVATE_REFERENCE_HMAC_KEY
XB_MEMBER_GATEWAY_SOURCE_TOKEN=REPLACE_WITH_PRIVATE_SOURCE_BEARER
XB_MEMBER_GATEWAY_OPERATOR_TOKEN=REPLACE_WITH_PRIVATE_OPERATOR_BEARER
XB_MEMBER_GATEWAY_CONTROL_TOKEN=REPLACE_WITH_PRIVATE_CONTROL_BEARER
XB_MEMBER_GATEWAY_WORKER_TOKEN=REPLACE_WITH_PRIVATE_WORKER_BEARER
XB_MEMBER_GATEWAY_MAILER_TOKEN=REPLACE_WITH_PRIVATE_MAILER_BEARER
