<?xml version="1.0" encoding="UTF-8"?>
<!--
  Energy@Grid daily bill run - INERT Task Scheduler template (integrated G3).

  This file registers nothing. It is a reviewed shape for a later, separately
  Owner-approved registration on the production host. Every REPLACE_WITH_*
  value is private host state and is substituted only in a local copy that is
  never committed. The template ships Enabled=false.

  Contract (asserted by tests/test_scheduler_template.py):
  - one daily CalendarTrigger at 08:00 +08:00; replace only REPLACE_WITH_START_DATE
    with the approved YYYY-MM-DD start date in a private local copy;
  - the action is the absolute Windows PowerShell 5.1 path invoking the
    installed launcher with -File (never Python, never the mutable checkout);
  - -File, not -Command: -File returns the script's own exit code, while a
    -Command wrapper returns 0 when the script cannot even be loaded;
  - -AuthorisedLauncherRootWriteSid takes ONE comma-separated argument; -File
    delivers it as a single string, which the launcher splits;
  - non-elevated (LeastPrivilege) run principal with a stored password, so
    DPAPI user-scope credential import works unattended;
  - MultipleInstancesPolicy IgnoreNew, plus the application's own single-run
    lock for manual overlap;
  - a hard ExecutionTimeLimit and StartWhenAvailable after a missed start.
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Energy@Grid daily direct-HTTP bill reconciliation through the governed launcher.</Description>
    <URI>\XB\EnergyGrid Daily Bills</URI>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>REPLACE_WITH_START_DATET08:00:00+08:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>REPLACE_WITH_RUN_PRINCIPAL</UserId>
      <LogonType>Password</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>false</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT30M</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe</Command>
      <Arguments>-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "REPLACE_WITH_LAUNCHER_ROOT\launcher.ps1" -ConfigPath "REPLACE_WITH_PRIVATE_CONFIG_JSON_PATH" -PythonExe "REPLACE_WITH_PYTHON_314_EXECUTABLE_PATH" -CheckoutRoot "REPLACE_WITH_DEPLOYED_CHECKOUT_ROOT" -CredentialPath "REPLACE_WITH_PRIVATE_DPAPI_PSCREDENTIAL_CLIXML_PATH" -BrowserCachePath "REPLACE_WITH_PRIVATE_PLAYWRIGHT_BROWSER_CACHE_PATH" -ExpectedBranch REPLACE_WITH_EXPECTED_BRANCH_OR_ANY_BRANCH -AuthorisedLauncherRootWriteSid REPLACE_WITH_COMMA_SEPARATED_AUTHORISED_SIDS -Command run -LogRoot "REPLACE_WITH_PRIVATE_DIAGNOSTICS_ROOT"</Arguments>
    </Exec>
  </Actions>
</Task>
