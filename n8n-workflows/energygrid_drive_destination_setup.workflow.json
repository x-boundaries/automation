      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nlet decided = null;\ntry { decided = $('Decide Tenant Bill Folder').first().json; } catch (error) {}\nlet recheck = null;\ntry { recheck = $('Recheck Tenant Bill Folder').first().json; } catch (error) {}\nlet folderId = decided && decided.create_required === false ? decided.folder_id : null;\nif (folderId === null) {\n  const files = recheck && recheck.statusCode === 200 && recheck.body && recheck.body.incompleteSearch === false &&\n    !recheck.body.nextPageToken && Array.isArray(recheck.body.files) ? recheck.body.files : null;\n  if (files === null) throw new Error('EG_DRIVE_SEARCH_INCOMPLETE');\n  const folders = files.filter((file) => file.mimeType === 'application/vnd.google-apps.folder' && file.trashed === false);\n  if (files.length !== 1 || folders.length !== 1) throw new Error('EG_DRIVE_CHILD_AMBIGUOUS');\n  folderId = folders[0].id;\n}\nreturn [{ json: { stream: 'TENANT_BILL', folder_id: folderId } }];\n"
