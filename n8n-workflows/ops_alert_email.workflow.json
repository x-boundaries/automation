    {
      "id": "00000000-0000-4000-8288-000000000002",
      "name": "Validate Alert Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Closed input of XB Ops Alert Email (#288). The trigger already trims undeclared fields; this node\n// also refuses them, so a caller that passes extra data gets a fixed reason code and no email.\n// Only the five allowlisted fields leave this node; nothing else can reach the subject or body.\n// Each request belongs to exactly one system: no field may name another system, and the flood\n// notice key is reserved, so one app's alert can never carry or fold into another app's.\nconst SYSTEMS = ['AC2-STOCK', 'ENERGYGRID', 'MEMBER-SYNC'];\nconst SEVERITIES = ['ERROR', 'WARN', 'INFO'];\nconst KEYS = ['key', 'lines', 'severity', 'short', 'system'];\nconst CODE_RE = /^[A-Za-z0-9_:+.-]{1,120}$/;\nconst LINE_RE = /^[\\x20-\\x7E]{0,300}$/;\nconst MAX_LINES = 30;\nconst MAX_BODY = 4000;\nconst RESERVED_KEYS = ['alert_flood'];\n\nconst items = $input.all();\nconst reject = (reason) => [{ json: { valid: false, reason } }];\nif (items.length !== 1) return reject('OPS_ALERT_ITEM_COUNT');\nconst req = items[0].json;\nif (!req || typeof req !== 'object' || Array.isArray(req)) return reject('OPS_ALERT_INPUT');\nif (Object.keys(req).sort().join('|') !== KEYS.join('|')) return reject('OPS_ALERT_KEYS');\nif (!SYSTEMS.includes(req.system)) return reject('OPS_ALERT_SYSTEM');\nif (!SEVERITIES.includes(req.severity)) return reject('OPS_ALERT_SEVERITY');\nif (typeof req.key !== 'string' || !CODE_RE.test(req.key)) return reject('OPS_ALERT_KEY');\nif (RESERVED_KEYS.includes(req.key)) return reject('OPS_ALERT_KEY');\nif (typeof req.short !== 'string' || !CODE_RE.test(req.short)) return reject('OPS_ALERT_SHORT');\nconst lines = req.lines;\nif (!Array.isArray(lines) || lines.length === 0 || lines.length > MAX_LINES) return reject('OPS_ALERT_LINES');\nif (!lines.every((line) => typeof line === 'string' && LINE_RE.test(line))) return reject('OPS_ALERT_LINES');\nif (lines.join('\\n').length > MAX_BODY) return reject('OPS_ALERT_LINES');\nconst others = SYSTEMS.filter((system) => system !== req.system);\nconst text = [req.key, req.short, ...lines].join('\\n');\nif (others.some((system) => text.includes(system))) return reject('OPS_ALERT_OTHER_SYSTEM');\nreturn [{ json: { valid: true, system: req.system, severity: req.severity, key: req.key, short: req.short, lines: [...lines] } }];\n"
      }
    },
