    {
      "id": "00000000-0000-4000-8288-000000000006",
      "name": "Decide Fold Or Send",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        200
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Fold and flood rules over the recent rows of the Data Table xb_alert_email_log (#288, G0 section 3).\n// - Fold: the same system:key within FOLD_MINUTES of its last `sent` row is not mailed (`folded`).\n// - Flood, per system: once FLOOD_CAP alert emails of this system were sent in the last 60 minutes, its\n//   further alerts are not mailed (`folded_flood`) and one \"[XB alert] <SYSTEM> WARN alert_flood\" notice\n//   goes out per 60 minutes for that system only. One system's flood never holds back another's alerts.\n// - The next real send of a key says \"(+k folded since HH:MM)\" (SGT), counting its held-back rows.\n// Every row this node reads is filtered to the request's own system first, so no email ever carries\n// another system's alert, count or time (owner, 6 Nov 2026: each app's alerts stay separate).\n// The read and the later insert are not atomic: the worst case is one extra email (accepted in G0).\n// A failed log read never blocks an alert: it is decided once on an empty history and logged with the\n// code log_read_failed. Read Recent Log continues on its regular output, so this node sees either log\n// rows, the single empty item `{}` (empty table), an item carrying `error`, or the bare request echo\n// (`valid === true`, which the Data Table router returns for some failures). The last two mean \"failed\".\n// Rows dated in the future (a clock that ran ahead) are ignored: they can neither fold nor flood.\nconst FOLD_MINUTES = 60;\nconst FLOOD_CAP = 10;\nconst FLOOD_KEY = 'alert_flood';\nconst HOUR_MS = 60 * 60 * 1000;\nconst SGT_OFFSET_MS = 8 * HOUR_MS; // Singapore has no daylight saving time.\n\nconst req = $('Validate Alert Request').first().json;\nconst request = { system: req.system, severity: req.severity, key: req.key, short: req.short, lines: req.lines };\nconst read = $input.all();\nconst readFailed = read.some((item) => item.error !== undefined\n  || (item.json && (item.json.error !== undefined || item.json.valid === true)));\nconst nowMs = Date.now();\nconst rows = readFailed ? [] : read\n  .map((item) => item.json)\n  .filter((row) => row && row.system === request.system && typeof row.key === 'string' && typeof row.outcome === 'string')\n  .map((row) => ({ ...row, at: Date.parse(row.sent_at) }))\n  .filter((row) => Number.isFinite(row.at) && row.at <= nowMs)\n  .sort((a, b) => a.at - b.at || (Number(a.id) || 0) - (Number(b.id) || 0));\n\nconst sentAt = new Date(nowMs).toISOString();\nconst hhmm = (ms) => new Date(ms + SGT_OFFSET_MS).toISOString().slice(11, 16);\nconst recent = (row, minutes) => nowMs - row.at < minutes * 60 * 1000;\nconst sameKey = (row) => row.key === request.key;\nconst code = readFailed ? 'log_read_failed' : '';\n\nconst lastSent = rows.filter((row) => sameKey(row) && row.outcome === 'sent').pop();\nconst held = rows.filter((row) => sameKey(row) && (row.outcome === 'folded' || row.outcome === 'folded_flood')\n  && (!lastSent || row.at > lastSent.at));\nconst sendsLastHour = rows.filter((row) => row.outcome === 'sent' && row.key !== FLOOD_KEY && recent(row, 60)).length;\nconst floodNoticeSent = rows.some((row) => row.key === FLOOD_KEY && row.outcome === 'sent' && recent(row, 60));\n\nconst footer = (system, severity, key) => [\n  '',\n  '--',\n  'System: ' + system + ' | Severity: ' + severity + ' | Key: ' + key,\n  'Times are SGT (UTC+08:00). Repeats of one system:key within ' + FOLD_MINUTES + ' minutes are folded; at most '\n    + FLOOD_CAP + ' alert emails per system per 60 minutes.',\n  'Log: n8n Data Table xb_alert_email_log. Contract: n8n-workflows/README.md, ops_alert_email.workflow.json.',\n];\nconst plan = (heldOutcome, mail, mailRow) => [{ json: {\n  held_outcome: heldOutcome,\n  held_row: heldOutcome ? { system: request.system, key: request.key, severity: request.severity,\n    outcome: heldOutcome, code, folded_count: 0, sent_at: sentAt } : null,\n  mail,\n  mail_row: mailRow ? { ...mailRow, code, sent_at: sentAt } : null,\n} }];\n\nif (lastSent && recent(lastSent, FOLD_MINUTES)) return plan('folded', null, null);\n\nif (sendsLastHour >= FLOOD_CAP) {\n  if (floodNoticeSent) return plan('folded_flood', null, null);\n  const text = [\n    'Alert flood: ' + sendsLastHour + ' ' + request.system + ' alert emails were sent in the last 60 minutes (cap '\n      + FLOOD_CAP + ').',\n    'Further ' + request.system + ' alerts are logged as folded_flood in xb_alert_email_log and not emailed until'\n      + ' the count drops.',\n    'This notice is sent at most once per 60 minutes for this system.',\n    '',\n    'First held back: ' + request.system + ' ' + request.severity + ' ' + request.short,\n    ...footer(request.system, 'WARN', FLOOD_KEY),\n  ].join('\\n');\n  return plan('folded_flood', { subject: '[XB alert] ' + request.system + ' WARN ' + FLOOD_KEY, text },\n    { system: request.system, key: FLOOD_KEY, severity: 'WARN', folded_count: 0 });\n}\n\nconst since = lastSent ? lastSent.at : (held.length ? held[0].at : null);\nconst foldNote = held.length ? ['', '(+' + held.length + ' folded since ' + hhmm(since) + ')'] : [];\nconst text = [...request.lines, ...foldNote, ...footer(request.system, request.severity, request.key)].join('\\n');\nreturn plan(null, { subject: '[XB alert] ' + request.system + ' ' + request.severity + ' ' + request.short, text },\n  { system: request.system, key: request.key, severity: request.severity, folded_count: held.length });\n"
      }
    },
