      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Gmail accepted the message once. A missing id is reported as uncertain, never as SENT.\nconst request = $('Validate Email Request').first().json.request;\nconst sent = $('Send Owner Email').first().json;\nconst id = sent && typeof sent.id === 'string' && /^[A-Za-z0-9_-]{1,200}$/.test(sent.id) ? sent.id : null;\nconst base = { schema: 'energygrid.owner_email.response.v1', mode: 'SEND', notification_id: request.notification_id,\n  dispatch_id: request.dispatch_id };\nif (!id) return [{ json: { response_code: 502, response: { ...base, outcome: 'SEND_UNCERTAIN' } } }];\nreturn [{ json: { response_code: 200, response: { ...base, outcome: 'SENT', message_id: id } } }];\n"
