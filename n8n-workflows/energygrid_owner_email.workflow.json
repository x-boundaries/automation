        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Owner Email: strict closed request, fixed recipient and subject prefix, render from fixed templates.\nconst SUBJECT_PREFIX = 'REPLACE_WITH_SUBJECT_PREFIX';\nconst RECIPIENT = 'REPLACE_WITH_OWNER_RECIPIENT';\nconst SCHEMA = 'energygrid.owner_email.response.v1';\nconst LABELS = { EB_BILL: 'EB Bill', TENANT_BILL: 'Tenant Bill' };\nconst SEND_KEYS = ['dispatch_id', 'display_filename', 'drive_file_id', 'kind', 'mode', 'notification_id',\n  'render_sha256', 'schema', 'status_text', 'stream', 'support_ref'].join('|');\n\nconst PROXY_HEADERS = ['cf-ray', 'cf-connecting-ip', 'cf-ipcountry', 'x-forwarded-for', 'x-forwarded-host', 'x-real-ip'];\nconst item = $input.first().json;\nconst headers = item && item.headers && typeof item.headers === 'object' ? item.headers : {};\nconst present = Object.keys(headers).map((key) => key.toLowerCase());\nif (PROXY_HEADERS.some((name) => present.includes(name))) {\n  // Defence in depth only: a proxy-marked request is answered 404 with no body. It is not the\n  // non-public boundary (that is the Cloudflare path exclusion or a private-only listener).\n  return [{ json: { route: 'NOT_FOUND' } }];\n}\nconst own = (value) => value !== null && typeof value === 'object' && !Array.isArray(value);\nconst body = item ? item.body : undefined;\n\nconst keys = own(body) ? Object.keys(body).sort().join('|') : '';\nconst refuse = (mode, nid, did) => [{ json: { route: 'REFUSED', response_code: 422, response: {\n  schema: SCHEMA, mode, notification_id: nid, dispatch_id: did, outcome: 'REFUSED', reason: 'EG_EMAIL_REQUEST_INVALID' } } }];\nif (!own(body) || body.schema !== 'energygrid.owner_email.request.v1') return refuse(null, null, null);\nif (body.mode === 'PROBE') {\n  if (keys !== 'mode|nonce|schema' || typeof body.nonce !== 'string' || !/^[0-9a-f]{32}$/.test(body.nonce)) {\n    return refuse('PROBE', null, null);\n  }\n  return [{ json: { route: 'PROBE', nonce: body.nonce, recipient_lower: RECIPIENT.toLowerCase() } }];\n}\nif (body.mode !== 'SEND') return refuse(null, null, null);\nconst nid = typeof body.notification_id === 'string' && /^egn-[0-9a-f]{32}$/.test(body.notification_id) ? body.notification_id : null;\nconst did = typeof body.dispatch_id === 'string' && /^egd-[0-9a-f]{32}$/.test(body.dispatch_id) ? body.dispatch_id : null;\nif (keys !== SEND_KEYS || !nid || !did) return refuse('SEND', nid, did);\nconst plainName = (value) => typeof value === 'string' && value.length >= 1 && value.length <= 255\n  && !/[\\u0000-\\u001f\\u007f]/.test(value) && value.toLowerCase().endsWith('.pdf');\nconst success = body.kind === 'SUCCESS';\nconst released = body.status_text === 'HOLD_RELEASED_NO_DISPATCH';\nconst valid = (body.kind === 'SUCCESS' || body.kind === 'FAILURE')\n  && Object.prototype.hasOwnProperty.call(LABELS, body.stream)\n  && typeof body.status_text === 'string' && /^[A-Z][A-Z0-9_]{2,63}$/.test(body.status_text)\n  && typeof body.render_sha256 === 'string' && /^[0-9a-f]{64}$/.test(body.render_sha256)\n  && (success\n    ? body.support_ref === null && plainName(body.display_filename)\n      && typeof body.drive_file_id === 'string' && /^[A-Za-z0-9_-]{10,200}$/.test(body.drive_file_id)\n    : typeof body.support_ref === 'string' && /^EG_[A-Z0-9_]{2,72}$/.test(body.support_ref)\n      && body.drive_file_id === null && (released ? plainName(body.display_filename) : body.display_filename === null));\nif (!valid) return refuse('SEND', nid, did);\nconst label = LABELS[body.stream];\nlet subject;\nlet text;\nif (success) {\n  subject = `${SUBJECT_PREFIX}: ${label} processed - ${body.display_filename}`;\n  text = `EnergyGrid processed a new ${label}.\\nFile: ${body.display_filename}\\n`\n    + `Google Drive: https://drive.google.com/file/d/${body.drive_file_id}/view\\n`;\n} else if (released) {\n  subject = `${SUBJECT_PREFIX}: ${label} hold released - ${body.support_ref}`;\n  text = `An operator released a held ${label} upload that was never sent to Google Drive.\\n`\n    + `File: ${body.display_filename}\\nStatus: ${body.status_text}\\nReference: ${body.support_ref}\\n`\n    + 'The next scheduled run tries it again; it is never uploaded twice. Check the EnergyGrid status report.\\n';\n} else {\n  subject = `${SUBJECT_PREFIX}: ${label} needs attention - ${body.support_ref}`;\n  text = `EnergyGrid could not complete the ${label} stream.\\nStatus: ${body.status_text}\\nReference: ${body.support_ref}\\n`\n    + 'Uncertain uploads are never retried automatically. Check the EnergyGrid status report.\\n';\n}\nreturn [{ json: { route: 'SEND', request: body, subject, text, canonical: subject + '\\n' + text, recipient: RECIPIENT } }];\n"
