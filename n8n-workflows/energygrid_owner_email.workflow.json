      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const SCHEMA = 'energygrid.owner_email.response.v1';\nconst request = $('Validate Email Request').first().json;\nconst hashed = $('Hash Recipient').first().json;\nconst who = $input.first().json;\nconst email = who && who.statusCode === 200 && who.body ? who.body.email : undefined;\nif (typeof email !== 'string' || !email || who.body.email_verified !== true) {\n  return [{ json: { response_code: 502, response: { schema: SCHEMA, mode: 'PROBE', nonce: request.nonce, ready: false } } }];\n}\nreturn [{ json: { response_code: 200, response: { schema: SCHEMA, mode: 'PROBE', nonce: request.nonce, ready: true,\n  sender_account: email, recipient_sha256: hashed.recipient_sha256 } } }];\n"
