{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/member_gateway_shopify_reconcile_claim.v1.schema.json",
  "title": "XB member gateway Shopify reconciliation claim v1",
  "description": "Worker-principal-only envelope for one uncertain Shopify write: the same bound MemberNo plus the retained transient create payload for exact read-only comparison; never a GID.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claimed",
    "job"
  ],
  "properties": {
    "schema_version": {
      "const": "xb.member.gateway.shopify_reconcile_claim.v1"
    },
    "claimed": {
      "type": "boolean"
    },
    "job": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "job_id",
            "source_system",
            "dispatch_fence_id",
            "member_no",
            "create_payload"
          ],
          "properties": {
            "job_id": {
              "type": "string",
              "pattern": "^job-[0-9a-f]{32}$"
            },
            "source_system": {
              "const": "shopify"
            },
            "dispatch_fence_id": {
              "type": "string",
              "pattern": "^fence-[A-Za-z0-9]{16,64}$"
            },
            "member_no": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,19}$"
            },
            "create_payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "mobile_phone",
                "email_address",
                "register_date",
                "expiry_date"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "mobile_phone": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9]{6,15}$"
                },
                "email_address": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "email",
                  "maxLength": 254
                },
                "register_date": {
                  "type": "string",
                  "format": "date"
                },
                "expiry_date": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          }
        }
      ]
    }
  }
}
