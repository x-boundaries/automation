{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/member_gateway_job.v3.schema.json",
  "title": "XB member gateway operator job view v3 (W-G2-149 sections 2.8 and 3)",
  "description": "GET /v1/jobs/{job_id} and /v1/jobs/{job_id}/status (operator.status.read). Metadata only: no customer field, no response id, no MemberNo, no member Guid, no XB-MN-1 base or name component and no lease token.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "request_id", "source_response_ref", "payload_hash", "operation", "source_system", "form_alias", "mapping_version", "member_no_rule", "state", "state_version", "outcome_reason", "attempt", "write_attempts", "write_budget", "busy_attempts", "first_claimed_at", "attempt_started_at", "next_attempt_at", "lease_expires_at"],
  "properties": {
    "schema_version": {"const": "xb.member.gateway.job.v3"},
    "job_id": {"type": "string", "pattern": "^job-[A-Za-z0-9]{16,64}$"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{0,200}$"},
    "source_response_ref": {"type": "string", "pattern": "^hmac-v1:[0-9a-f]{64}$"},
    "payload_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "operation": {"const": "member.create"},
    "source_system": {"const": "google_forms"},
    "form_alias": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{0,100}$"},
    "mapping_version": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{0,100}$"},
    "member_no_rule": {"type": ["string", "null"], "enum": ["XB-MN-1", null]},
    "state": {"type": "string", "enum": ["RECEIVED", "VALIDATED", "QUEUED", "LEASED", "PRECHECKING", "ALLOCATION_BOUND", "WRITE_INTENT_RECORDED", "WRITING", "READBACK", "CREATED_VERIFIED", "REJECTED_VALIDATION", "RETRY_WAIT", "AMBIGUOUS_LOOKUP", "WRITE_OUTCOME_UNCERTAIN", "WRITER_TERMINATION_UNCONFIRMED", "CONFIRMED_NOT_CREATED", "CREATED_READBACK_MISMATCH", "MANUAL_REVIEW", "DEAD_LETTER", "LINKED_EXISTING", "RESOLVED"]},
    "state_version": {"type": "integer", "minimum": 0},
    "outcome_reason": {"type": ["string", "null"], "pattern": "^[a-z0-9_.:-]{1,80}$"},
    "attempt": {"type": "integer", "minimum": 0},
    "write_attempts": {"type": "integer", "minimum": 0, "maximum": 12},
    "write_budget": {"type": "integer", "minimum": 1, "maximum": 12},
    "busy_attempts": {"type": "integer", "minimum": 0, "maximum": 12},
    "first_claimed_at": {"type": ["string", "null"], "format": "date-time"},
    "attempt_started_at": {"type": ["string", "null"], "format": "date-time"},
    "next_attempt_at": {"type": ["string", "null"], "format": "date-time"},
    "lease_expires_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
