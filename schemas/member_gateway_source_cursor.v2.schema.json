{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/member_gateway_source_cursor.v2.schema.json",
  "title": "XB member source cursor v2",
  "description": "Fixed-cutover, receipt-driven source cursor. Supersedes v1, which is retained unchanged for compatibility. The deprecated admitted tuple and resume token are intentionally absent and carry no admission, filtering, checkpoint or skip authority. Page tokens and raw response IDs are private to the source principal.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_system",
    "form_alias",
    "mapping_version",
    "production_cutover_exact",
    "filter_exact",
    "admission_mode",
    "page_size",
    "cursor_state_version",
    "accepted_member_count",
    "accepted_member_allowance_remaining",
    "active_epoch"
  ],
  "properties": {
    "schema_version": {
      "const": "xb.member.gateway.source_cursor.v2"
    },
    "source_system": {
      "const": "google_forms"
    },
    "form_alias": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,100}$"
    },
    "mapping_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,100}$"
    },
    "production_cutover_exact": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3}|\\.[0-9]{6}|\\.[0-9]{9})?Z$"
    },
    "filter_exact": {
      "type": "string",
      "pattern": "^timestamp >= [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3}|\\.[0-9]{6}|\\.[0-9]{9})?Z$"
    },
    "admission_mode": {
      "enum": [
        "first_member",
        "continuous"
      ]
    },
    "page_size": {
      "const": 1
    },
    "cursor_state_version": {
      "type": "integer",
      "minimum": 0
    },
    "accepted_member_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "accepted_member_allowance_remaining": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "active_epoch": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "epoch_id",
        "status",
        "admission_mode",
        "epoch_state_version",
        "current_page_token",
        "page_ordinal",
        "predecessor_epoch_id",
        "restart_reason",
        "open_page"
      ],
      "properties": {
        "epoch_id": {
          "type": "string",
          "pattern": "^epoch-[0-9a-f]{32}$"
        },
        "status": {
          "const": "ACTIVE"
        },
        "admission_mode": {
          "enum": [
            "first_member",
            "continuous"
          ]
        },
        "epoch_state_version": {
          "type": "integer",
          "minimum": 0
        },
        "current_page_token": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[ -~]+$"
        },
        "page_ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "predecessor_epoch_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^epoch-[0-9a-f]{32}$"
        },
        "restart_reason": {
          "enum": [
            null,
            "token_invalidated",
            "ambiguous_crashed_attempt"
          ]
        },
        "open_page": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "page_id",
            "page_ordinal",
            "page_state",
            "request_page_token",
            "next_page_token",
            "terminal",
            "item_count",
            "items"
          ],
          "properties": {
            "page_id": {
              "type": "string",
              "pattern": "^page-[0-9a-f]{32}$"
            },
            "page_ordinal": {
              "type": "integer",
              "minimum": 0
            },
            "page_state": {
              "const": "OPEN"
            },
            "request_page_token": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[ -~]+$"
            },
            "next_page_token": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[ -~]+$"
            },
            "terminal": {
              "type": "boolean"
            },
            "item_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            },
            "items": {
              "type": "array",
              "maxItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "response_id",
                  "create_time",
                  "payload_hash"
                ],
                "properties": {
                  "response_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._:-]{1,200}$"
                  },
                  "create_time": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3}|\\.[0-9]{6}|\\.[0-9]{9})?Z$"
                  },
                  "payload_hash": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "resumed": {
      "type": "boolean"
    }
  }
}
