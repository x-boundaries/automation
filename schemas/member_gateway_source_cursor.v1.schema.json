{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/member_gateway_source_cursor.v1.schema.json",
  "title": "XB member source cursor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_system", "form_alias", "mapping_version", "watermark", "last_admitted_create_time", "last_admitted_response_id", "state_version", "scan_lower_bound", "resume_page_token", "initial_window_admission_count"],
  "properties": {
    "schema_version": {"const": "xb.member.gateway.source_cursor.v1"},
    "source_system": {"const": "google_forms"},
    "form_alias": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,100}$"},
    "mapping_version": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,100}$"},
    "watermark": {"type": "string", "format": "date-time"},
    "last_admitted_create_time": {"type": ["string", "null"], "format": "date-time"},
    "last_admitted_response_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]{1,200}$"},
    "state_version": {"type": "integer", "minimum": 0},
    "scan_lower_bound": {"type": "string", "format": "date-time"},
    "resume_page_token": {"type": ["string", "null"], "minLength": 1, "maxLength": 1024, "pattern": "^[ -~]+$"},
    "initial_window_admission_count": {"type": "integer", "minimum": 0, "maximum": 1}
  }
}
