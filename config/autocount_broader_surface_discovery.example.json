        "transfer",
        "fromlocation",
        "tolocation",
        "intransit"
      ]
    },
    "stock_reference_followup": {
      "keyword_hints": [
        "item",
        "stock",
        "uom",
        "balance",
        "movement",
        "stockdtl"
      ]
    }
  },
  "stock_smoke_reference_surfaces": [
    {
      "schema_name": "dbo",
      "object_name": "Item",
      "status": "reference_only_not_final_mapping",
