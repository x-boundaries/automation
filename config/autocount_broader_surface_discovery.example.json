        "ledger",
        "coa",
        "accno",
        "journal"
      ]
    },
    "ar_ap_opening": {
      "keyword_hints": [
        "ar",
        "ap",
        "opening",
        "receivable",
        "payable",
        "balance"
      ]
    },
    "locations": {
      "keyword_hints": [
        "location",
        "warehouse",
        "store",
        "branch"
      ]
    },
    "payment_methods": {
      "keyword_hints": [
        "payment",
        "paymethod",
        "cash",
