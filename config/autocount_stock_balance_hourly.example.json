{
  "timezone": "Asia/Singapore",
  "schedule": {
    "frequency": "hourly",
    "run_minute": 0,
    "logon_type": "S4U"
  },
  "stale_after_minutes": 70,
  "source": {
    "server": "EXAMPLE-SQL-HOST\\EXAMPLE",
    "odbc_driver": "ODBC Driver 17 for SQL Server",
    "expected_database": "AED_EXAMPLE_BOOK",
    "allowed_databases": ["AED_EXAMPLE_BOOK"],
    "encrypt": false,
    "trust_server_certificate": false,
    "sync_registration_time_column": "LastFinishSyncTime"
  },
  "identity": {
    "auth_mode": "windows_integrated",
    "sql_login": null,
    "credential_target": null,
    "allow_privileged_identity": false
  },
  "read": {
    "lock_timeout_ms": 5000,
    "query_timeout_seconds": 60,
    "max_attempts": 3,
    "retry_backoff_seconds": 2
  },
  "rows": {
    "zero_row_mode": "keep_rows_and_add_items_without_rows",
    "drop_zero_rows_for_inactive_items": true,
    "uom_guard": "fail",
    "exclude_non_stock_items": true
  },
  "location_labels": {
    "LOC-A": "LOC-A - Example outlet",
    "LOC-GIT": "LOC-GIT - Example in transit"
  },
  "output": {
    "archive_root": "C:\\EXAMPLE\\automation\\autocount_outputs\\stock_balance_hourly",
    "delivery_root": "D:\\EXAMPLE\\DriveForDesktop\\Report\\AC2 Stock Balance (daily)",
    "columns": [
      "as_of_local",
      "ItemCode",
      "ItemDescription",
      "ItemType",
      "Location",
      "LocationLabel",
      "UOM",
      "BalQty",
      "IsActive",
      "StockControl",
      "RowSource"
    ],
    "large_balance_threshold": 100000
  },
  "daily_close": {
    "backfill_start": "2026-08-01",
    "restate_days": 7
  },
  "retention": {
    "prune_enabled": false,
    "hourly_keep_hours": 48,
    "daily_keep_days": 90
  },
  "feed": {
    "low_stock_threshold": 2,
    "list_cap": 200,
    "movers_top": 20
  },
  "alert": {
    "webhook_enabled": false,
    "webhook_url": "https://n8n.example.com/webhook/REPLACE_WITH_ALERT_WEBHOOK_PATH",
    "auth_header_name": "X-XB-Alert-Token",
    "secret_env_var": "XB_AC2_STOCK_ALERT_SECRET",
    "secret_credential_target": null,
    "timeout_seconds": 10,
    "repeat_hours": 24
  },
  "analysis": {
    "enabled": false,
    "golive_day": "2026-07-31",
    "stock_take_day": null,
    "sales_window_days": 400,
    "doc_types": {
      "sales": ["OS", "IV", "DO"],
      "returns": ["CN"],
      "receipts": ["GR", "PI"]
    },
    "channel_by_location": {
      "LOC-A": {"OS": "outlet"},
      "LOC-E": {"IV": "marketplace", "CN": "marketplace"}
    },
    "channel_by_debtor": {
      "FAKE-DEBTOR-ONLINE": "shopify"
    },
    "debtor_default_channel": "wholesale",
    "pools": {
      "retail_network": ["LOC-HQ", "LOC-A", "LOC-E"],
      "outlets": ["LOC-A"],
      "esales": ["LOC-E"],
      "wholesale": ["LOC-W"]
    },
    "placement": {
      "min_hold": 2,
      "pairs": [
        {"id": "held_at_wholesale", "label": "Held at wholesale", "zero_locations": ["LOC-A", "LOC-E"], "holder_locations": ["LOC-W"]},
        {"id": "online_out_shop_has", "label": "Online out, shop has it", "zero_locations": ["LOC-E"], "holder_locations": ["LOC-A", "LOC-HQ"]},
        {"id": "transfer_from_hq", "label": "Transfer from HQ", "zero_locations": ["LOC-A"], "holder_locations": ["LOC-HQ"]}
      ]
    },
    "highlights": {
      "pool": "retail_network",
      "channels": ["outlet", "marketplace", "shopify"],
      "top_n": 20,
      "sold_out_days": 28,
      "sell_through_pct": 80,
      "drift_pts": 3,
      "drift_min_units": 100,
      "slow_days": 60
    },
    "attributes": {
      "kids_categories": ["FAKE-KIDS"],
      "size_class_by_category": {
        "FAKE-FOOTWEAR": "footwear",
        "FAKE-KIDS": "kids",
        "FAKE-PANTS": "waist"
      }
    }
  }
}
